@startuml
!theme plain
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam sequence {
    ArrowColor #DC2626
    ActorBorderColor #DC2626
    ActorBackgroundColor #FEF2F2
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1E293B
    BorderThickness 1.2
    ArrowColor #475569
    FontStyle bold
}

left to right direction

actor "Hội viên\n(Member)" as Member #FEF2F2
actor "Huấn luyện viên\n(Trainer PT)" as PT #F0FDF4

rectangle "Phân Hệ Đặt Lịch Huấn Luyện Viên 1-1 (UC-06)" {
    
    usecase "UC-06: Đặt lịch tập 1-1\ncùng Huấn luyện viên (PT)" as UC_Main #EFF6FF
    
    usecase "Tra cứu lịch rảnh\ncủa Huấn luyện viên" as UC_CheckPT
    usecase "Kiểm tra số buổi còn lại\ntrong hợp đồng (>= 1)" as UC_CheckSessions
    usecase "Kiểm soát xung đột trùng lịch\n(MySQL Transaction)" as UC_Lock
    
    usecase "Xác nhận lịch hẹn &\nGửi email nhắc lịch (Nodemailer)" as UC_Success #F0FDF4
    usecase "Cảnh báo trùng giờ &\nRollback giao dịch CSDL" as UC_Conflict #FFF1F2
    usecase "Hủy lịch hẹn trước 02 giờ\n(Không bị trừ buổi)" as UC_Cancel
}

' Tương tác Actor
Member --> UC_Main
Member --> UC_Cancel
PT --> UC_Main

' Mối quan hệ Include
UC_Main .> UC_CheckPT : <<include>>
UC_Main .> UC_CheckSessions : <<include>>
UC_Main .> UC_Lock : <<include>>

' Mối quan hệ Extend
UC_Success .> UC_Main : <<extend>>\n(Không có xung đột)
UC_Conflict .> UC_Main : <<extend>>\n(Trùng giờ PT hoặc Hội viên)

@enduml

